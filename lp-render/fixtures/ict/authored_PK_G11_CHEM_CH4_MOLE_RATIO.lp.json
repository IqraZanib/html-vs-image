     "steps": [
      "$100/24 = 4.17$ mol \\ce{Mg}",
      "\\ce{Mg}:\\ce{H2} = 1:1",
      "$4.17$ mol \\ce{H2}",
      "$4.17 \\times 22.4 = 93.4$ dm³"
     ],
     "result": "$93.4$ dm³ \\ce{H2}"
    },
    {
     "type": "diagram",
     "spec": {
      "type": "panels",
      "panels": [
       {
        "title": "Mg",
        "sub": "1 mol",
        "glyph": "Mg",
        "lines": [
         "24 g/mol"
        ],
        "foot": "100 g = 4.17 mol"
       },
       {
        "title": "H2",
        "sub": "1 mol",
        "glyph": "H–H",
        "lines": [
