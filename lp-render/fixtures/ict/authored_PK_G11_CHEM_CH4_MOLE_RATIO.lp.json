    {
     "type": "say",
     "id": "intro_say1",
     "text": "Balanced equation: \\ce{N2 + 3H2 -> 2NH3}."
    },
    {
     "type": "watch_out",
     "text": "Don't guess — use exact method.",
     "misconception": false
    },
    {
     "type": "board",
     "text": "\\ce{N2(g) + 3H2(g) -> 2NH3(g)}"
    }
   ],
   "layout": "half"
